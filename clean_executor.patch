+SPORTS_INTENT_PREFIX = "sports:"
+# A claim still 'sending' after this long means the process died mid-order.
+UNRESOLVED_MIN_AGE_SECONDS = 60
+# Kalshi positions appear within seconds of a fill; after this long with no position the
+# uncertain order is treated as unfilled (the claim is kept, so the market is not re-bought).
+UNRESOLVED_GIVE_UP_SECONDS = 15 * 60
+
+
+def _sports_intent_ticker(ticker: str) -> str:
+    return f"{SPORTS_INTENT_PREFIX}{ticker}"
+
+
+def _size_sports_order(wager: float, price: float) -> tuple:
+    """(contracts, worst_case_cost) for a sports entry. The worst-case fill (ask + the 4c
+    slippage buffer place_sports_order allows) plus the Kalshi taker fee must fit inside the
+    wager. Returns (0, 0.0) when the wager can't buy one contract - the old sizing forced
+    max(1, ...) and could spend more than the user's wager."""
+    max_p = min(0.99, max(0.01, float(price) + 0.04))
+    count = int(float(wager) / max_p) if max_p > 0 else 0
+    while count > 0 and (count * max_p + kalshi_order_fee(max_p, count)) > float(wager):
+        count -= 1
+    if count < 1:
+        return 0, 0.0
+    return count, round(count * max_p + kalshi_order_fee(max_p, count), 2)
+
